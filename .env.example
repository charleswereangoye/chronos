# ==========================================
# CHRONOS CONFIGURATION & ENVIRONMENT KEYS
# ==========================================

# Google Gemini API Keys (Supports automatic rotation & load balancing)
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=optional_secondary_gemini_key_here
GEMINI_API_KEY_3=optional_tertiary_gemini_key_here
GEMINI_API_KEY_4=optional_quaternary_gemini_key_here

# Groq API Fallback (Optional, zero-cost failover with Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here

# Telegram Orchestrator Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Social Media Integration - X (Twitter)
X_USERNAME=your_x_username_here
X_PASSWORD=your_x_password_here

# Social Media Integration - Meta (Facebook Pages & Instagram)
FB_PAGE_ID=your_facebook_page_id_here
IG_USER_ID=your_instagram_user_id_here
META_PAGE_ACCESS_TOKEN=your_meta_long_lived_page_access_token_here

# Operational Modes
DRY_RUN=false
LOG_LEVEL=INFO
